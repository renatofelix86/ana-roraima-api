# ANA
ANA_BASE_URL=https://www.ana.gov.br/hidrowebservice/EstacoesTelemetricas
ANA_IDENTIFIER=SEU_CPF_OU_CNPJ
ANA_PASSWORD=SUA_SENHA

# PostgreSQL
POSTGRES_DB=hidrologia
POSTGRES_USER=hidrologia
POSTGRES_PASSWORD=troque-esta-senha
DATABASE_URL=postgresql+psycopg://hidrologia:troque-esta-senha@db:5432/hidrologia

# Proteção da API corporativa.
# Envie este valor no header X-API-Key.
APP_API_KEY=troque-por-uma-chave-forte

# Coleta
ANA_UF=RR
# HORA_24 traz ~93 registros por chamada contra ~5 do HORA_2. Como a gravação é
# UPSERT, a janela larga faz a coleta se auto-curar: uma parada de até 24h é
# recuperada sozinha, sem furo permanente na série.
TELEMETRY_RANGE=HORA_24
COLLECT_INTERVAL_MINUTES=15
STATION_SYNC_INTERVAL_HOURS=24

# Fusos.
# ANA_SOURCE_TZ: fuso em que a ANA carimba a telemetria. Verificado
# empiricamente: estações de RR, AC e SP consultadas no mesmo instante devolvem
# o mesmo horário, e só UTC-3 é compatível com a hora real.
# LOCAL_TZ: fuso do negócio, usado no dia-calendário dos dashboards.
ANA_SOURCE_TZ=America/Sao_Paulo
LOCAL_TZ=America/Boa_Vista

# Carga histórica (HidroSerieCotas), ano a ano e retomável.
BACKFILL_ENABLED=true
# Piso para estações cujo inventário não informa início de série.
BACKFILL_START_YEAR=1960
BACKFILL_REQUEST_DELAY=0.35
BACKFILL_INTERVAL_HOURS=24

# Usuario somente-leitura do Power BI (SELECT apenas nas views bi_*).
# Criado por: docker compose run --rm api python -m app.bi_user
BI_READONLY_USER=powerbi_ro
BI_READONLY_PASSWORD=defina-uma-senha-forte

# Porta do Postgres no host (pgAdmin/Power BI). A 5432 costuma estar ocupada
# pelo PostgreSQL nativo instalado junto com o pgAdmin.
DB_HOST_PORT=5433

# Porta da API no host. Ajuste se 8000 ja estiver em uso na VPS.
API_HOST_PORT=8000

# ---------------------------------------------------------------------------
# Somente na VPS: publicar a API pelo Traefik, com HTTPS.
# Descomente as duas linhas. Com COMPOSE_FILE definido, `docker compose up -d`
# carrega a sobreposicao automaticamente -- o comando nao muda.
# O DNS do dominio precisa apontar para a VPS ANTES de subir, senao a emissao
# do certificado Let's Encrypt falha.
# ---------------------------------------------------------------------------
# COMPOSE_FILE=docker-compose.yml:docker-compose.traefik.yml
# API_DOMAIN=hidrologia.cbm.rr.gov.br

# Papel de aplicacao SEM superusuario, criado por app.harden_db.
# E o unico papel de escrita alcancavel por TCP; o superusuario 'hidrologia'
# fica restrito ao socket local (ver postgres/pg_hba.conf).
# Gere com: openssl rand -hex 24
PG_APP_USER=hidro_app
PG_APP_PASSWORD=defina-com-pelo-menos-16-caracteres

# Interface em que o Postgres e publicado no host.
# 127.0.0.1 = so a propria maquina (padrao, seguro).
# 0.0.0.0   = exposto a internet -- SO com docker-compose.exposed.yml ativo.
DB_BIND_IP=127.0.0.1
